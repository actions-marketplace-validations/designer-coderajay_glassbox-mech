{
 "_about": "Reproduction recipes for V7 evidence packages (glassbox.v7.reproduce). 'commit' is the commit at which the results were committed unchanged, so its code is the code that produced them. Commands run from the root of a checkout at that commit and write to repro/, never to the committed results.",
 "v7-exp1-rag-fault": {
  "commit": "aedfebf",
  "setup": [
   "python3.11 -m venv .venv-repro",
   ".venv-repro/bin/pip install -q \"numpy==1.26.4\" \"scipy==1.17.1\" \"einops==0.8.2\" \"torch==2.10.0\" \"transformer-lens==2.17.0\" \"transformers==4.57.6\" \"pyarrow==23.0.0\" \"datasets==4.5.0\" \"pandas==3.0.0\" pytest",
   ".venv-repro/bin/pip install -q -e . --no-deps"
  ],
  "run": [
   ".venv-repro/bin/python experiments/v7/rag_fault/run.py --out repro/exp1"
  ],
  "results": [
   "repro/exp1/results.json"
  ],
  "packaged_results": [
   "measurements/results.json"
  ],
  "tol": 0.0001,
  "ignore": [],
  "runtime": "minutes on a laptop CPU; downloads GPT-2 small",
  "notes": ""
 },
 "v7-exp2-llama-dedup": {
  "commit": "72cb710",
  "setup": [
   "python3.11 -m venv .venv-repro",
   ".venv-repro/bin/pip install -q \"numpy==1.26.4\" \"scipy==1.17.1\" \"einops==0.8.2\" \"torch==2.10.0\" \"transformer-lens==2.17.0\" \"transformers==4.57.6\" \"pyarrow==23.0.0\" \"datasets==4.5.0\" \"pandas==3.0.0\" pytest",
   ".venv-repro/bin/pip install -q -e . --no-deps",
   "python3 -m venv ~/.glassbox-venvs/li-0.14.17",
   "~/.glassbox-venvs/li-0.14.17/bin/pip install -q \"llama-index-core==0.14.17\"",
   "python3 -m venv ~/.glassbox-venvs/li-0.14.19",
   "~/.glassbox-venvs/li-0.14.19/bin/pip install -q \"llama-index-core==0.14.19\""
  ],
  "run": [
   "for v in 0.14.17 0.14.19; do for p in sync async; do for r in r1 r2; do ~/.glassbox-venvs/li-$v/bin/python experiments/v7/llama_dedup/subject.py --path $p --run $r --out repro/exp2; done; done; done",
   ".venv-repro/bin/python experiments/v7/llama_dedup/evaluate.py --results repro/exp2"
  ],
  "results": [
   "repro/exp2/results.json"
  ],
  "packaged_results": [
   "measurements/results.json"
  ],
  "tol": 0.0001,
  "ignore": [
   "environment_differences_bug_vs_fix"
  ],
  "runtime": "minutes; no model",
  "notes": ""
 },
